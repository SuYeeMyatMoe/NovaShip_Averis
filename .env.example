# ============ NovaShip Averis — environment (copy to .env) ============
# --- Persistence: memory (offline demo, seeded from bundle) | supabase
REPO_BACKEND=memory
TENANT_ID=tenant_april
# Supabase (Project Settings > API). Server secrets stay BACKEND-ONLY.
# They may be stored as encrypted Vercel server environment variables, but must never be NEXT_PUBLIC_*.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Prefer the modern sb_secret_* server key; legacy service_role remains supported.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key
# Explicit legacy JWT compatibility only: set algorithm=HS256 and provide the old shared secret.
SUPABASE_JWT_ALGORITHM=JWKS
SUPABASE_JWT_SECRET=your-jwt-secret-from-project-settings-api
SUPABASE_STORAGE_BUCKET=documents

# --- AI provider: none (offline/default) | openai
LLM_PROVIDER=none
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini          # optional OpenAI chat model override; pin a snapshot for strict reproducibility

# --- Trained intent classifier (rules remain the high-confidence first layer)
INTENT_MODEL_ENABLED=1
INTENT_MODEL_PATH=./models/intent_classifier.joblib  # relative to backend/ in local runs

# --- RAG for Ask AI (embeddings + vector store)
EMBEDDING_PROVIDER=local        # gemini | openai | local (offline hashing fallback)
GOOGLE_API_KEY=                 # aistudio.google.com/app/apikey -> Gemini text-embedding-004
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768        # must match live case_embeddings vector(768)
VECTOR_STORE=local              # production/live RAG: supabase; local = backend/data/index.json
SUPABASE_VECTOR_DIMENSIONS=768
RAG_DATA_DIR=./data             # knowledge folder (relative to backend/)

# --- LangGraph checkpoints (paused human-in-the-loop graphs)
LANGGRAPH_CHECKPOINT=memory     # memory | postgres
# Persistent Docker/local backend: use Supabase direct connection, or Shared Pooler session mode (port 5432) on IPv4.
LANGGRAPH_PG_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
LANGGRAPH_STRICT_MSGPACK=true    # restrict checkpoint deserialization to known-safe types
OCR_ENABLED=0                   # 1 = try pytesseract on image-only PDFs (needs tesseract + poppler installed)

# --- Auth. The UI always logs in (POST /auth/login -> signed session token, 12 h).
#   demo : session tokens + `X-User-Id` header accepted (tests, curl, scripts)
#   local: signed local sessions, no X-User-Id and no demo credential seeding
#   jwt  : Supabase Bearer JWT only (no local sessions/login/register or header impersonation)
AUTH_MODE=demo
SESSION_SECRET=change-me-in-production      # signs session tokens; rotating it logs everyone out
SESSION_TTL_HOURS=12
DEMO_PASSWORD=novaship123                   # password seeded for every demo account (see README "Test accounts")
REGISTER_ALLOWED_ROLES=OPERATIONS_STAFF     # least privilege by default. Hackathon demo: ADMIN,SUPERVISOR,OPERATIONS_STAFF (Admin first)
SELF_REGISTRATION_ENABLED=0                 # local only; demo keeps hackathon registration enabled

# --- Gmail API — real email connector
EMAIL_PROVIDER=none             # none | bundle | gmail
EMAIL_SEND_MODE=simulate        # simulate | gmail  (NEVER sends without human approval)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ADDRESS=
# One-time local authorization after setting the client ID/secret:
# python backend/scripts/gmail_authorize.py


# --- Routing / deployment
# Vercel Services defaults the backend to /api automatically. Override only if needed.
API_PREFIX=
# NEXT_PUBLIC_API_BASE is optional on Vercel; production frontend defaults to same-origin /api.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Misc
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_ENV=development
LOG_LEVEL=INFO
BUNDLE_DIR=./sdoc-hackathon-bundle
MAX_UPLOAD_BYTES=10485760
MAX_ATTACHMENT_COUNT=10
SEED_SNAPSHOT=./supabase/seed/snapshot.json
AUTO_SEED=1
# Host ports for Docker Compose. Must match NEXT_PUBLIC_API_BASE if you change API_PORT.
# Do not run local npm run dev / uvicorn on the same ports as Compose.
# WEB_PORT=3000
# API_PORT=8000
