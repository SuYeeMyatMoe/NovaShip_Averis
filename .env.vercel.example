# NovaShip Averis — Vercel Services environment template
# Add values in Vercel Project -> Settings -> Environment Variables.
# Never commit real values.

REPO_BACKEND=supabase
TENANT_ID=tenant_april
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
AUTO_SEED=0

LANGGRAPH_CHECKPOINT=postgres
LANGGRAPH_PG_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
LANGGRAPH_STRICT_MSGPACK=true

VECTOR_STORE=supabase
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=768
SUPABASE_VECTOR_DIMENSIONS=768

LLM_PROVIDER=none
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Individual mailboxes only: users sign in with Microsoft (then Connect Outlook) or Google; no shared mailbox needed.
EMAIL_PROVIDER=none
EMAIL_SEND_MODE=simulate
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=https://<your-domain>/api/auth/microsoft/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://<your-domain>/api/auth/google/callback
FRONTEND_URL=https://<your-domain>
MAILBOX_TOKEN_KEY=
# Optional shared desk mailbox (EMAIL_PROVIDER=gmail):
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ADDRESS=

AUTH_MODE=demo
SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
SESSION_TTL_HOURS=12
DEMO_PASSWORD=novaship123
SELF_REGISTRATION_ENABLED=0
REGISTER_ALLOWED_ROLES=OPERATIONS_STAFF

API_PREFIX=/api
# NEXT_PUBLIC_API_BASE is intentionally omitted: production frontend defaults to /api.

APP_ENV=demo
LOG_LEVEL=INFO
OCR_ENABLED=0
MAX_UPLOAD_BYTES=10485760
MAX_ATTACHMENT_COUNT=10

# For APP_ENV=production:
# CORS_ORIGINS=https://your-project.vercel.app
